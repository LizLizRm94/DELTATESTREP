@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var clientUrl = Configuration["ClientBaseUrl"] ?? "https://localhost:7105/";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Iniciar sesión</h2>
        <div id="message" class="text-danger mb-2"></div>
        <form id="loginForm">
            <div class="mb-3">
                <label for="username" class="form-label">CI o correo</label>
                <input type="text" id="username" name="username" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password" id="password" name="password" class="form-control"
                       autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>
</div>

<script>
    document.getElementById('loginForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        document.getElementById('message').textContent = '';

        const payload = {
            username: document.getElementById('username').value,
            password: document.getElementById('password').value
        };

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                let msg;
                if (res.status === 401) {
                    msg = 'El usuario o la contraseña son incorrectos. Por favor, verifica tus credenciales e inténtalo nuevamente.';
                } else if (res.status === 400) {
                    msg = 'No se pudo procesar la solicitud. Verifica los datos e inténtalo nuevamente.';
                } else if (res.status === 429) {
                    msg = 'Demasiados intentos. Intente nuevamente en un minuto.';
                } else {
                    msg = 'No se pudo iniciar sesión. Intente nuevamente.';
                }
                document.getElementById('message').textContent = msg;
                return;
            }

            // La sesión se guarda en una cookie HttpOnly emitida por el servidor.
            window.location.href = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clientUrl));
        } catch (err) {
            document.getElementById('message').textContent = 'No se pudo iniciar sesión. Intente nuevamente.';
        }
    });
</script>
