<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DELTA - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" />
    <style>
        body { background:#f6f8fb; color:#1e293b; font-family:'Segoe UI',system-ui,sans-serif; line-height:1.6; }
        .navbar { background:white !important; border-bottom:1px solid #dce3ec; }
        .container { max-width:1100px; padding:24px; }
        .form-control { min-height:46px; border-radius:12px; border-color:#a7b4c5; }
        .btn { border-radius:12px; min-height:44px; font-weight:600; }
        .btn-primary { background:#b94a10; border-color:#b94a10; }
        .btn-primary:hover { background:#963b0c; border-color:#963b0c; }
        :is(a,button,input):focus-visible { outline:3px solid #b94a10; outline-offset:3px; }
        .row.justify-content-center { margin:0; padding-block:24px; }
        .row.justify-content-center > .col-md-6 { max-width:480px; background:white; border:1px solid #dce3ec; border-radius:16px; padding:32px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">DELTA</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Account/Login">Iniciar sesión</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
</body>
</html>