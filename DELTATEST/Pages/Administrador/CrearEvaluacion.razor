@page "/CrearEvaluacion"
@attribute [Authorize(Roles = "Administrador,Inspector")]
@layout MainSinLayout
@inject NavigationManager Nav

<div class="pantalla-evaluacion">
    <h3 class="titulo-evaluacion">CREE SUS EVALUACIONES</h3>

    <div class="contenedor-botones">
        <button class="btn-cuadrado" @onclick='() => Nav.NavigateTo("/EvaluacionTeorica")'>
            TEÓRICA
        </button>

        <button class="btn-cuadrado" @onclick='() => Nav.NavigateTo("/EvaluacionPracticaLista")'>
            PRÁCTICO
        </button>
    </div>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        overflow-x: hidden;
    }

    .pantalla-evaluacion {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
        text-align: center;
    }

    .titulo-evaluacion {
        font-size: clamp(1.35rem, 5vw, 2.25rem);
        margin-bottom: 2rem;
        font-weight: bold;
        color: #333;
    }

    .contenedor-botones {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
        width: 100%;
    }

    .btn-cuadrado {
        width: 100%;
        max-width: 240px;
        min-height: 100px;
        height: auto;
        font-size: clamp(1rem, 4vw, 1.375rem);
        font-weight: 600;
        color: white;
        background-color: #F98220;
        border: none;
        border-radius: 0px;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease, background-color 0.3s ease;
    }

    .btn-cuadrado:hover {
        background-color: #e06f1c;
        transform: scale(1.05);
    }

    .btn-cuadrado:active {
        transform: scale(0.98);
    }

    .footer {
        display: none !important;
    }

    @@media (max-width: 767.98px) {
        .pantalla-evaluacion { padding: 1rem; }
        .contenedor-botones { flex-direction: column; align-items: center; gap: .9rem; }
        .btn-cuadrado { max-width: 100%; min-height: 72px; }
    }
</style>
