@page "/EvaluacionTeorica"
@using DELTATEST.Models
@using System.Text.Json
@inject HttpClient Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@layout MainSinLayout

<h3 class="titulo-form">EVALUACION TEORICA</h3>

@if (mostrarMensaje)
{
    <div class="alerta @(esError ? "alerta-error" : "alerta-exito")">
        <span>@mensajeRespuesta</span>
        <button type="button" class="btn-cerrar" @onclick="CerrarMensaje">&times;</button>
    </div>
}

<form @onsubmit="OnSubmit">
    <div class="form-evaluacion">
        <!-- Selector de usuario -->
        <div class="fila-pregunta">
            <label class="label-pregunta">Seleccionar Usuario</label>
            <select class="input-respuesta" @bind="idUsuarioSeleccionado" disabled="@cargando">
      <option value="0">-- Seleccione un usuario --</option>
         @if (usuarios != null)
     {
             @foreach (var usuario in usuarios)
            {
       <option value="@usuario.IdUsuario">@usuario.NombreCompleto</option>
              }
          }
  </select>
        </div>

        <!-- ========== HU11: ASISTENTE DE IA PARA EL ADMINISTRADOR ========== -->
        <div class="panel-ia">
            <div class="panel-ia-header">
                <span class="panel-ia-titulo">Asistente de IA para el Administrador</span>
                <span class="panel-ia-badge">HU11 · Delta</span>
            </div>
            <p class="panel-ia-desc">
                Genera automáticamente las 5 preguntas abiertas y las 5 de opción múltiple,
                contextualizadas en el rubro farmacéutico de Delta (medicamentos, desarrollo
                farmacéutico y normativas de salud).
            </p>

            <div class="panel-ia-controles">
                <div class="campo-ia">
                    <label class="label-pregunta">Subárea Farmacéutica / Tema</label>
                    <select class="input-respuesta" @bind="subareaSeleccionada" disabled="@cargandoIA">
                        @foreach (var subarea in subareasFarmaceuticas)
                        {
                            <option value="@subarea">@subarea</option>
                        }
                    </select>
                </div>

                <div class="campo-ia">
                    <label class="label-pregunta">Nivel de Dificultad</label>
                    <select class="input-respuesta" @bind="dificultadSeleccionada" disabled="@cargandoIA">
                        @foreach (var nivel in nivelesDificultad)
                        {
                            <option value="@nivel">@nivel</option>
                        }
                    </select>
                </div>

                <div class="campo-ia campo-ia-boton">
                    <button type="button" class="btn btn-ia" @onclick="GenerarPreguntasConIA" disabled="@cargandoIA">
                        @if (cargandoIA)
                        {
                            <span class="spinner"></span>
                            <span>Generando preguntas...</span>
                        }
                        else
                        {
                            <span>Generar Preguntas con IA</span>
                        }
                    </button>
                </div>
            </div>

            @if (cargandoIA)
            {
                <div class="ia-cargando">
                    <span class="spinner"></span>
                    <span>
                        La IA está redactando preguntas de <strong>@subareaSeleccionada</strong>
                        (nivel @dificultadSeleccionada). Esto puede tardar unos segundos...
                    </span>
                </div>
            }
        </div>
        <!-- ========== FIN HU11 ========== -->

    <!-- SECCIÓN 1: Preguntas Abiertas -->
   @if (modelo?.PreguntasAbiertas != null && modelo.PreguntasAbiertas.Count > 0)
        {
        <div class="seccion-preguntas">
                <h4 class="titulo-seccion">Preguntas Abiertas (5)</h4>
     @foreach (var pregunta in modelo.PreguntasAbiertas)
       {
       <div class="fila-pregunta">
  <label class="label-pregunta">Pregunta @(modelo.PreguntasAbiertas.IndexOf(pregunta) + 1)</label>
   <input type="text" class="input-respuesta" @bind="pregunta.Texto" @bind:event="oninput" placeholder="Ingrese la pregunta abierta" />
    </div>
       <div class="fila-pregunta">
          <label class="label-pregunta">Puntos</label>
   <input type="number" class="input-respuesta" @bind="pregunta.Puntos" min="0" placeholder="0" />
    </div>
}
            </div>
        }

        <!-- SECCIÓN 2: Preguntas Opción Múltiple -->
        @if (modelo?.PreguntasMultiples != null && modelo.PreguntasMultiples.Count > 0)
   {
         <div class="seccion-preguntas">
      <h4 class="titulo-seccion">Preguntas de Opción Múltiple (5)</h4>
      @foreach (var pregunta in modelo.PreguntasMultiples)
     {
 var indexPregunta = modelo.PreguntasMultiples.IndexOf(pregunta);
   <div class="pregunta-multiple">
         <div class="pregunta-multiple-header">
  <label class="label-pregunta">Pregunta @(indexPregunta + 1)</label>
         <input type="text" class="input-respuesta input-pregunta" @bind="pregunta.Texto" @bind:event="oninput" placeholder="Ingrese la pregunta" />
  </div>

   <div class="puntos-row">
    <label class="label-pregunta">Puntos</label>
    <input type="number" class="input-respuesta input-puntos" @bind="pregunta.Puntos" min="0" placeholder="0" />
 </div>

   <div class="opciones-container">
       @if (pregunta.OpcionesLista != null && pregunta.OpcionesLista.Count > 0)
       {
    @foreach (var opcion in pregunta.OpcionesLista)
    {
  var indexOpcion = pregunta.OpcionesLista.IndexOf(opcion);
   <div class="opcion-item">
       <div class="opcion-header">
     <label class="label-opcion">Opción @((char)('A' + indexOpcion))</label>
      <input type="checkbox" class="checkbox-correcta" 
 @onchange="@((ChangeEventArgs e) => MarcarOpcionCorrecta(pregunta, indexOpcion, (bool)e.Value!))" 
   checked="@opcion.EsCorrecta" 
  title="Marcar como respuesta correcta" />
      <span class="label-checkbox">Correcta</span>
    @if (pregunta.OpcionesLista.Count > 2)
   {
      <button type="button" class="btn-eliminar-opcion" @onclick="@(() => EliminarOpcion(pregunta, indexOpcion))" title="Eliminar esta opción">
   -
          </button>
      }
      </div>
   <input type="text" class="input-respuesta" @bind="opcion.Texto" @bind:event="oninput" placeholder="Ingrese la opción" />
     </div>
      }
 }
     </div>

     <!-- Botón para agregar opción -->
       <button type="button" class="btn-agregar-opcion" @onclick="@(() => AgregarOpcion(pregunta))">
 + Agregar Opción
    </button>
             </div>
     }
        </div>
     }

   <div class="acciones">
   <button type="submit" class="btn btn-primario" disabled="@(cargando || idUsuarioSeleccionado == 0)">
       @if (cargando)
        {
        <span>Guardando...</span>
      }
      else
          {
        <span>Subir</span>
       }
       </button>

            <button type="button" class="btn btn-secundario" @onclick="OnCancel" disabled="@cargando">Cancelar</button>
        </div>
    </div>
</form>

@code {
    private EvaluacionTeoricaModelo modelo = new();
    private List<UserViewModel>? usuarios;
    private int idUsuarioSeleccionado = 0;
    private bool cargando = false;
    private bool mostrarMensaje = false;
    private string mensajeRespuesta = string.Empty;
    private bool esError = false;

    // ===== HU11: Asistente de IA =====
    private bool cargandoIA = false;
    private string subareaSeleccionada = "Desarrollo de Medicamentos";
    private string dificultadSeleccionada = "Intermedio";

    private readonly List<string> subareasFarmaceuticas = new()
    {
        "Desarrollo de Medicamentos",
        "Farmacología Clínica",
        "Control de Calidad Farmacéutica",
        "Buenas Prácticas de Manufactura",
        "Normativas de Salud y Regulatorio",
        "Farmacovigilancia"
    };

    private readonly List<string> nivelesDificultad = new()
    {
        "Básico",
        "Intermedio",
        "Avanzado"
    };

    protected override async Task OnInitializedAsync()
    {
 await CargarUsuarios();
        InicializarPreguntas();
    }

  private async Task CargarUsuarios()
    {
        try
        {
         usuarios = await Http.GetFromJsonAsync<List<UserViewModel>>("api/usuarios");
   }
        catch (Exception ex)
        {
       Console.WriteLine($"Error cargando usuarios: {ex.Message}");
   usuarios = new List<UserViewModel>();
   mostrarMensaje = true;
       esError = true;
    mensajeRespuesta = $"Error al cargar usuarios: {ex.Message}";
     }
    }

    private void InicializarPreguntas()
  {
        try
        {
            // Inicializar 5 preguntas abiertas
    modelo.PreguntasAbiertas = Enumerable.Range(1, 5)
        .Select(i => new Pregunta { Texto = string.Empty, TipoEvaluacion = true })
     .ToList();

       // Inicializar 5 preguntas de opción múltiple con 2 opciones iniciales
modelo.PreguntasMultiples = Enumerable.Range(1, 5)
              .Select(i => new Pregunta
          {
            Texto = string.Empty,
           TipoEvaluacion = false,
       OpcionesLista = Enumerable.Range(1, 2)
     .Select(j => new Opcion { Texto = string.Empty, EsCorrecta = false })
        .ToList()
                })
         .ToList();
        }
        catch (Exception ex)
 {
          Console.WriteLine($"Error en InicializarPreguntas: {ex.Message}");
   }
    }

    private void AgregarOpcion(Pregunta pregunta)
    {
      if (pregunta.OpcionesLista == null)
      pregunta.OpcionesLista = new List<Opcion>();

        pregunta.OpcionesLista.Add(new Opcion { Texto = string.Empty, EsCorrecta = false });
    }

    private void EliminarOpcion(Pregunta pregunta, int indexOpcion)
    {
        if (pregunta.OpcionesLista == null || indexOpcion < 0 || indexOpcion >= pregunta.OpcionesLista.Count)
 return;

 pregunta.OpcionesLista.RemoveAt(indexOpcion);
    }

    private void MarcarOpcionCorrecta(Pregunta pregunta, int indexOpcion, bool esCorrecta)
{
        if (pregunta.OpcionesLista == null) return;

      // Desmarcar todas las opciones
      foreach (var opcion in pregunta.OpcionesLista)
   {
      opcion.EsCorrecta = false;
        }

        // Marcar solo la seleccionada
     if (esCorrecta && indexOpcion < pregunta.OpcionesLista.Count)
   {
            pregunta.OpcionesLista[indexOpcion].EsCorrecta = true;
    }
  }

  private async Task OnSubmit()
    {
      if (idUsuarioSeleccionado == 0)
        {
   mostrarMensaje = true;
    esError = true;
  mensajeRespuesta = "Debe seleccionar un usuario";
       return;
      }

   cargando = true;
        try
     {
    // Validar preguntas abiertas
      var preguntasAbiertasValidas = modelo.PreguntasAbiertas
 .Where(p => !string.IsNullOrWhiteSpace(p.Texto))
    .ToList();

    // Validar preguntas múltiples
      var preguntasMultiplesValidas = modelo.PreguntasMultiples
    .Where(p => !string.IsNullOrWhiteSpace(p.Texto) && 
p.OpcionesLista.Count >= 2 && 
 p.OpcionesLista.All(o => !string.IsNullOrWhiteSpace(o.Texto)) &&
           p.OpcionesLista.Any(o => o.EsCorrecta))
   .ToList();

      if (preguntasAbiertasValidas.Count == 0 && preguntasMultiplesValidas.Count == 0)
   {
        mostrarMensaje = true;
         esError = true;
     mensajeRespuesta = "Debe ingresar al menos una pregunta completa. Las preguntas múltiples deben tener mínimo 2 opciones y una marcada como correcta.";
     cargando = false;
    return;
  }

     // Preparar preguntas abiertas
       var preguntasAbiertas = preguntasAbiertasValidas.Take(5).Select(p => new
    {
   texto = p.Texto,
        tipoEvaluacion = true,
     opciones = (string?)null,
        puntos = p.Puntos,
    opcionesConCorrecta = new List<object>()
}).ToList();

     // Preparar preguntas múltiples con opciones serializadas
  var preguntasMultiples = preguntasMultiplesValidas.Take(5).Select(p => new
  {
 texto = p.Texto,
     tipoEvaluacion = false,
       opciones = JsonSerializer.Serialize(p.OpcionesLista.Select(o => new { texto = o.Texto, esCorrecta = o.EsCorrecta }).ToList()),
        puntos = p.Puntos,
  opcionesConCorrecta = p.OpcionesLista.Select(o => new { texto = o.Texto, esCorrecta = o.EsCorrecta }).ToList()
   }).ToList();

      // Combinar todas las preguntas
  var todasLasPreguntas = new List<dynamic>();
     todasLasPreguntas.AddRange(preguntasAbiertas);
         todasLasPreguntas.AddRange(preguntasMultiples);

  var requestEvaluacion = new
       {
    idUsuario = idUsuarioSeleccionado,
    preguntas = todasLasPreguntas.Cast<object>().ToList()
 };

   var responseEvaluacion = await Http.PostAsJsonAsync("api/evaluaciones/crear-evaluacion-teorica", requestEvaluacion);

        if (responseEvaluacion.IsSuccessStatusCode)
   {
  mostrarMensaje = true;
        esError = false;
        mensajeRespuesta = "¡Evaluación teórica creada exitosamente!";
      await Task.Delay(2000);
      OnCancel();
   }
     else
{
     var contenidoError = await responseEvaluacion.Content.ReadAsStringAsync();
   mostrarMensaje = true;
     esError = true;
   mensajeRespuesta = $"Error al crear evaluación: {responseEvaluacion.StatusCode} - {contenidoError}";
    }
        }
catch (Exception ex)
        {
   mostrarMensaje = true;
        esError = true;
        mensajeRespuesta = $"Error: {ex.Message}";
}
     finally
     {
       cargando = false;
        }
    }

    // ===== HU11: Generar preguntas con IA (Gemini) =====
    private async Task GenerarPreguntasConIA()
    {
        if (cargandoIA) return;

        cargandoIA = true;
        mostrarMensaje = false;

        try
        {
            var request = new
            {
                subarea = subareaSeleccionada,
                dificultad = dificultadSeleccionada,
                cantidadAbiertas = 5,
                cantidadMultiples = 5,
                puntosAbiertas = 10,
                puntosMultiples = 10
            };

            // Cliente dedicado con timeout amplio: la generación con IA puede tardar más de 30 s
            var httpIa = HttpClientFactory.CreateClient("AI");
            var response = await httpIa.PostAsJsonAsync("api/evaluaciones/generar-ia", request);
            var contenido = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                var detalle = ExtraerMensajeError(contenido);

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                    response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    detalle = "Solo un usuario con rol Administrador (Inspector) puede usar el asistente de IA.";
                }

                mostrarMensaje = true;
                esError = true;
                mensajeRespuesta = $"No se pudieron generar las preguntas: {detalle}";
                return;
            }

            var resultado = JsonSerializer.Deserialize<GenerarIAResponse>(
                contenido,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (resultado == null)
            {
                mostrarMensaje = true;
                esError = true;
                mensajeRespuesta = "La IA devolvió una respuesta vacía. Intente nuevamente.";
                return;
            }

            // --- Autocompletar preguntas abiertas ---
            var abiertas = new List<Pregunta>();
            if (resultado.PreguntasAbiertas != null)
            {
                foreach (var p in resultado.PreguntasAbiertas)
                {
                    if (string.IsNullOrWhiteSpace(p.Texto)) continue;

                    abiertas.Add(new Pregunta
                    {
                        Texto = p.Texto.Trim(),
                        TipoEvaluacion = true,
                        Puntos = p.Puntos > 0 ? p.Puntos : 10,
                        OpcionesLista = new List<Opcion>()
                    });
                }
            }
            while (abiertas.Count < 5)
            {
                abiertas.Add(new Pregunta
                {
                    Texto = string.Empty,
                    TipoEvaluacion = true,
                    Puntos = 10,
                    OpcionesLista = new List<Opcion>()
                });
            }

            // --- Autocompletar preguntas de opción múltiple ---
            var multiples = new List<Pregunta>();
            if (resultado.PreguntasMultiples != null)
            {
                foreach (var p in resultado.PreguntasMultiples)
                {
                    if (string.IsNullOrWhiteSpace(p.Texto) || p.Opciones == null) continue;

                    var opciones = p.Opciones
                        .Where(o => !string.IsNullOrWhiteSpace(o.Texto))
                        .Select(o => new Opcion
                        {
                            Texto = o.Texto.Trim(),
                            EsCorrecta = o.EsCorrecta
                        })
                        .ToList();

                    // Garantizar mínimo 2 opciones y una marcada como correcta
                    if (opciones.Count < 2) continue;
                    if (!opciones.Any(o => o.EsCorrecta))
                        opciones[0].EsCorrecta = true;

                    multiples.Add(new Pregunta
                    {
                        Texto = p.Texto.Trim(),
                        TipoEvaluacion = false,
                        Puntos = p.Puntos > 0 ? p.Puntos : 10,
                        OpcionesLista = opciones
                    });
                }
            }
            while (multiples.Count < 5)
            {
                multiples.Add(new Pregunta
                {
                    Texto = string.Empty,
                    TipoEvaluacion = false,
                    Puntos = 10,
                    OpcionesLista = new List<Opcion>
                    {
                        new Opcion { Texto = string.Empty, EsCorrecta = false },
                        new Opcion { Texto = string.Empty, EsCorrecta = false }
                    }
                });
            }

            modelo.PreguntasAbiertas = abiertas.Take(5).ToList();
            modelo.PreguntasMultiples = multiples.Take(5).ToList();

            mostrarMensaje = true;
            esError = false;
            mensajeRespuesta = $"✅ La IA generó {modelo.PreguntasAbiertas.Count} preguntas abiertas y {modelo.PreguntasMultiples.Count} de opción múltiple sobre \"{subareaSeleccionada}\" (nivel {dificultadSeleccionada}).";
        }
        catch (Exception ex)
        {
            mostrarMensaje = true;
            esError = true;
            mensajeRespuesta = $"Error al generar preguntas con IA: {ex.Message}";
        }
        finally
        {
            cargandoIA = false;
        }
    }

    private static string ExtraerMensajeError(string contenido)
    {
        if (string.IsNullOrWhiteSpace(contenido)) return "Error desconocido del servidor.";

        try
        {
            using var doc = JsonDocument.Parse(contenido);
            string? mensaje = null;
            string? detalle = null;

            if (doc.RootElement.TryGetProperty("mensaje", out var m))
                mensaje = m.GetString();
            else if (doc.RootElement.TryGetProperty("error", out var e))
                mensaje = e.GetString();

            if (doc.RootElement.TryGetProperty("detalle", out var d))
                detalle = d.GetString();

            // Intentar extraer el mensaje de error real de Gemini
            if (!string.IsNullOrWhiteSpace(detalle))
            {
                try
                {
                    using var gem = JsonDocument.Parse(detalle);
                    if (gem.RootElement.TryGetProperty("error", out var ge) &&
                        ge.TryGetProperty("message", out var gm))
                    {
                        return gm.GetString() ?? detalle;
                    }
                }
                catch
                {
                    // detalle no es JSON de Gemini: se usa tal cual más abajo
                }
            }

            if (!string.IsNullOrWhiteSpace(mensaje) && !string.IsNullOrWhiteSpace(detalle))
                return $"{mensaje} Detalle: {detalle}";
            if (!string.IsNullOrWhiteSpace(detalle)) return detalle!;
            if (!string.IsNullOrWhiteSpace(mensaje)) return mensaje!;
        }
        catch
        {
            // El contenido no es JSON: se devuelve tal cual.
        }

        return contenido;
    }

    private void OnCancel()
    {
        NavigationManager.NavigateTo("/panelControlAdmin");
    }

    private void CerrarMensaje()
    {
  mostrarMensaje = false;
    }

    // ===== HU11: DTOs para la respuesta de la IA =====
    private class GenerarIAResponse
    {
        public List<PreguntaIADto>? PreguntasAbiertas { get; set; }
        public List<PreguntaMultipleIADto>? PreguntasMultiples { get; set; }
    }

    private class PreguntaIADto
    {
        public string Texto { get; set; } = string.Empty;
        public int Puntos { get; set; }
    }

    private class PreguntaMultipleIADto : PreguntaIADto
    {
        public List<OpcionIADto>? Opciones { get; set; }
    }

    private class OpcionIADto
    {
        public string Texto { get; set; } = string.Empty;
        public bool EsCorrecta { get; set; }
    }
}

<style>
    .titulo-form {
        text-align: center;
        margin: 20px 0 30px;
        font-weight: 600;
      letter-spacing: 0.5px;
    font-size: 28px;
    }

    .form-evaluacion {
        max-width: 900px;
        margin: 0 auto;
 padding: 24px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 6px 24px rgba(0,0,0,0.06);
        max-height: none;
        overflow: hidden;
    }

    .fila-pregunta {
 display: grid;
   grid-template-columns: 180px 1fr;
        gap: 16px;
        align-items: center;
     margin-bottom: 14px;
    }

    .label-pregunta {
        font-weight: 500;
    color: #374151;
    }

    .input-respuesta {
        width: 100%;
        padding: 10px 12px;
 border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
    }

    .input-respuesta:focus {
        outline: none;
        border-color: #f58220;
        box-shadow: 0 0 0 3px rgba(245, 130, 32, 0.1);
    }

    .seccion-preguntas {
     margin: 30px 0;
        padding: 20px;
        background: #f9fafb;
        border-radius: 8px;
      border-left: 4px solid #f58220;
    }

    .titulo-seccion {
        font-size: 16px;
        font-weight: 600;
   color: #1f2937;
    margin-bottom: 20px;
 padding-bottom: 10px;
        border-bottom: 2px solid #e5e7eb;
    }

    .pregunta-multiple {
        margin-bottom: 25px;
        padding: 20px;
        background: white;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
}

    .pregunta-multiple-header {
        margin-bottom: 15px;
  }

    .input-pregunta {
   margin-top: 8px;
    }

    .puntos-row {
   display: flex;
        align-items: center;
      gap: 12px;
        margin-bottom: 15px;
  }

    .input-puntos {
     max-width: 150px;
    }

.opciones-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 15px;
        margin-top: 15px;
   margin-bottom: 15px;
    }

    .opcion-item {
    display: flex;
        flex-direction: column;
        background: #f3f4f6;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
    }

    .opcion-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
