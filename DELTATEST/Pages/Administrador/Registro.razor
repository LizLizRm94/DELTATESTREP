@page "/Registro"
@attribute [Authorize(Roles = "Administrador,Inspector")]

@using Microsoft.AspNetCore.Components.Forms
@using DELTATEST.Models
@inject DELTATEST.Services.AuthService AuthService
@layout MainSinLayout
@inject NavigationManager Navigation

<div class="delta-screen delta-screen-registro" data-page="registro">
<style>
    .form-container { display:flex; justify-content:center; align-items:center; min-height:100vh; padding:1rem; overflow-y:auto; }
    .form-box { width:100%; max-width:420px; padding:clamp(1.25rem, 5vw, 1.875rem); border:1px solid #e6e6e6; border-radius: var(--delta-radius, 16px); }
    .btn-primary { background-color:#e5a650; color:white; padding:10px; width:100%; min-height:44px; border:none; border-radius: var(--delta-radius, 16px) }
    .form-control { min-height:44px; }

    @@media (max-width: 575.98px) {
        .form-container { padding:0.75rem; align-items:flex-start; }
        .form-box h2 { font-size:1.4rem; }
        .form-control { font-size:16px; }
    }
</style>

    <div class="form-container">
        <div class="form-box">
            <h2>Registro de usuarios</h2>
            <p class="text-muted small">Registra una cuenta. El inspector puede crear cuentas con rol Usuario; el administrador también puede asignar otros roles.</p>

            @if (isSubmitting)
            {
                <div class="text-center mb-3">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-2">Creando cuenta...</p>
                </div>
            }

            <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label>Nombre completo</label>
                    <InputText @bind-Value="model.NombreCompleto" class="form-control" />
                    <ValidationMessage For="() => model.NombreCompleto" />
                </div>

                <div class="mb-2">
                    <label>Correo</label>
                    <InputText @bind-Value="model.Correo" type="email" class="form-control" />
                    <ValidationMessage For="() => model.Correo" />
                </div>

                <div class="mb-2">
                    <label>CI (opcional)</label>
                    <InputText @bind-Value="model.Ci" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Extensión</label>
                    <InputSelect @bind-Value="model.Expedicion" class="form-control">
                        <option value="">Seleccionar extensión</option>
                        <option value="LP">LP</option>
                        <option value="SC">SC</option>
                        <option value="CB">CB</option>
                        <option value="OR">OR</option>
                        <option value="PT">PT</option>
                        <option value="TJ">TJ</option>
                        <option value="BN">BN</option>
                        <option value="CH">CH</option>
                        <option value="PD">PD</option>
                    </InputSelect>
                    <ValidationMessage For="() => model.Expedicion" />
                </div>

                <div class="mb-2">
                    <label>Teléfono (opcional)</label>
                    <InputText type="tel" autocomplete="tel" maxlength="50" @bind-Value="model.Telefono" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Fecha de ingreso (opcional)</label>
                    <InputDate @bind-Value="model.FechaIngreso" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Rol</label>
                    <InputSelect @bind-Value="model.Rol" class="form-control">
                        <option value="Usuario">Usuario</option>
                        <AuthorizeView Roles="Administrador" Context="roleAuthorization">
                            <option value="Inspector">Inspector</option>
                            <option value="Administrador">Administrador</option>
                        </AuthorizeView>
                    </InputSelect>
                </div>

                <VinculacionLaboralFields @bind-Tipo="model.TipoEvaluado" @bind-PuestoActual="model.PuestoActual" @bind-PuestoARotar="model.PuestoARotar" @bind-PuestoSolicitado="model.PuestoSolicitado" Disabled="@isSubmitting" />

                <div class="mb-2">
                    <label for="registro-password">Contraseña</label>
                    <div class="password-field"><InputText id="registro-password" @bind-Value="model.Password" type="@(mostrarPassword ? "text" : "password")" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" @onclick="() => mostrarPassword = !mostrarPassword" aria-controls="registro-password" aria-pressed="@(mostrarPassword ? "true" : "false")" title="@(mostrarPassword ? "Ocultar contraseña" : "Ver contraseña")" aria-label="@(mostrarPassword ? "Ocultar contraseña" : "Ver contraseña")"><i class="bi @(mostrarPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></button></div>
                    <ValidationMessage For="() => model.Password" />
                </div>

                <div class="mb-2">
                    <label for="registro-confirmacion">Confirmar contraseña</label>
                    <div class="password-field"><InputText id="registro-confirmacion" @bind-Value="model.ConfirmPassword" type="@(mostrarConfirmacion ? "text" : "password")" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" @onclick="() => mostrarConfirmacion = !mostrarConfirmacion" aria-controls="registro-confirmacion" aria-pressed="@(mostrarConfirmacion ? "true" : "false")" title="@(mostrarConfirmacion ? "Ocultar contraseña" : "Ver contraseña")" aria-label="@(mostrarConfirmacion ? "Ocultar contraseña" : "Ver contraseña")"><i class="bi @(mostrarConfirmacion ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></button></div>
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="text-danger">@message</div>
                }

                <button type="submit" class="btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <span>Crear cuenta</span>
                    }
                </button>

            </EditForm>

            <div style="margin-top:10px">
                <a href="/panelControlAdmin">Volver al panel</a>
            </div>
        </div>
    </div>



</div>
@code {
    private bool mostrarPassword, mostrarConfirmacion;
    private RegisterModel model = new() { Rol = "Usuario" };
    private string? message;
    private bool isSubmitting = false;

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        message = null;
        StateHasChanged();

        var (success, rol, msg, nombre) = await AuthService.RegisterAsync(model);

        if (success)
        {
            Navigation.NavigateTo("/verUsuarios");
            return;
        }

        message = msg ?? "Error al registrar.";
        isSubmitting = false;
    }
}

