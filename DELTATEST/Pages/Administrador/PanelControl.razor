@page "/panelControlAdmin"
@attribute [Authorize(Roles = "Administrador,Inspector")]
@layout MainSinLayout
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="delta-screen delta-screen-panelcontrol" data-page="panelcontrol">
<section class="admin-dashboard">
    <h1 class="h3 fw-bold text-center mb-2">Panel de Control de @(esAdministrador ? "Administrador" : "Inspector")</h1>
    <p class="text-center mb-4 h5">@(isLoading ? "Cargando..." : $"Bienvenido {userName}")</p>
    <div class="admin-actions">
        <a href="/verUsuarios" class="card dashboard-card"><div class="card-body text-center p-4"><div class="icon-circle mx-auto mb-3"><img src="images/eye.png" class="icon-img" alt="" /></div><h2 class="h5">Administrar cuentas</h2><p>Administra las cuentas de usuario.</p></div></a>
        <a href="/CrearEvaluacion" class="card dashboard-card"><div class="card-body text-center p-4"><div class="icon-circle mx-auto mb-3"><img src="images/user.png" class="icon-img" alt="" /></div><h2 class="h5">Crear Evaluación</h2><p>Define nuevos formularios de evaluación.</p></div></a>
        <a href="/admin/evaluaciones-teoricas" class="card dashboard-card"><div class="card-body text-center p-4"><div class="icon-circle mx-auto mb-3"><img src="images/view.png" class="icon-img" alt="" /></div><h2 class="h5">Ver Evaluación</h2><p>Visualiza y califica evaluaciones.</p></div></a>
        <AuthorizeView Roles="Administrador,Inspector">
            <Authorized>
                <a href="/administrador/convocatorias" class="card dashboard-card"><div class="card-body text-center p-4"><div class="icon-circle mx-auto mb-3"><i class="bi bi-file-earmark-text fs-1" aria-hidden="true"></i></div><h2 class="h5">Administrar convocatorias</h2><p>Consulta las convocatorias y crea nuevas publicaciones.</p></div></a>
            </Authorized>

        </AuthorizeView>
    </div>
    <AuthorizeView Roles="Administrador"><div class="text-center mt-4"><a href="/Registro" class="btn btn-orange">Crear cuenta</a></div></AuthorizeView>
</section>

<style>
    .admin-dashboard { max-width: 1450px; margin: 0 auto; padding: clamp(2rem,6vh,5rem) 1.5rem; }
    .admin-actions { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1.5rem; }
    .admin-actions .dashboard-card { color:#333; text-decoration:none; border:0; box-shadow:0 2px 5px #0001; }
    .admin-actions .icon-circle { background:#f58220; }
    .admin-actions p { color:#666; margin-bottom:0; }
    .admin-actions .restricted-card { cursor:default; background:#f5f5f5; }
    .admin-actions .restricted-card .icon-circle { background:#ddd; }
    @@media(max-width:1100px) { .admin-actions { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:575.98px) { .admin-actions { grid-template-columns:minmax(0,1fr); } }

    .bg-primary-soft,
    .bg-success-soft,
    .bg-warning-soft,
    .bg-info-soft {
   background-color: #f58220 !important;
    }

    .dashboard-card {
        cursor: pointer;
     transition: transform 0.2s, box-shadow 0.2s;
   border-radius: var(--delta-radius, 16px);
 }

        .dashboard-card:hover {
            transform: translateY(-5px);
       box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

  .icon-circle {
        width: 80px;
     height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
    justify-content: center;
    }

    .icon-img {
        width: 50%;
   height: 50%;
      object-fit: contain;
    }
    @@media (max-width: 767.98px) {
        .dashboard-card .card-body { padding: 1rem !important; }
        .icon-circle { width: 60px; height: 60px; }
        .dashboard-card h5 { font-size: 1rem; }
        .dashboard-card p { font-size: .8rem; }
        .container-fluid.vh-100 { height: auto !important; min-height: 100vh; }
    }

    @@media (max-width: 575.98px) {
        .dashboard-card .card-body { padding: .75rem !important; }
    }
</style>


</div>
@code {
    private bool esAdministrador;
    private string? userName;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            userName = state.User.Identity?.Name;
            esAdministrador = state.User.IsInRole("Administrador");
        }
        catch
        {
            userName = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void IrACrearEvaluacion()
    {
     Nav.NavigateTo("/CrearEvaluacion");
    }

    private void IrARegistro()
    {
      Nav.NavigateTo("/Registro");
    }

    private void IrAVerUsuario()
    {
      Nav.NavigateTo("/verUsuarios");
    }

    private void IrAVerEvaluaciones()
    {
        Nav.NavigateTo("/admin/evaluaciones-teoricas");
    }
}
