@page "/editarUsuario/{IdUsuario:int}"
@attribute [Authorize(Roles = "Administrador,Inspector")]
@layout MainSinLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="delta-screen delta-screen-editarusuario" data-page="editarusuario">
<h1 class="h3 mb-4 text-center">Editar usuario</h1>
@if (isLoading) { <p role="status" class="text-center">Cargando usuario...</p> }
else if (errorCarga != null)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
    <button type="button" class="btn btn-secondary" @onclick="Cargar">Reintentar</button>
}
else
{
    <div class="card p-4 mx-auto" style="max-width:600px">
        @if (mensaje != null) { <div class="alert @(guardado ? "alert-success" : "alert-danger")" role="status">@mensaje</div> }
        <EditForm Model="usuario" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@(guardando || guardado)">
                <div class="row">
                    <div class="col-12 mb-3"><label for="nombre">Nombre completo</label><InputText id="nombre" class="form-control" @bind-Value="usuario.NombreCompleto" maxlength="255" /><ValidationMessage For="@(() => usuario.NombreCompleto)" /></div>
                    <div class="col-12 mb-3"><label for="correo">Correo</label><InputText id="correo" type="email" class="form-control" @bind-Value="usuario.Correo" maxlength="255" autocomplete="email" /><ValidationMessage For="@(() => usuario.Correo)" /></div>
                    <div class="col-md-6 mb-3"><label for="ci">CI</label><InputText id="ci" class="form-control" @bind-Value="usuario.Ci" maxlength="50" /><ValidationMessage For="@(() => usuario.Ci)" /></div>
                    <div class="col-md-6 mb-3"><label for="telefono">Teléfono</label><InputText id="telefono" type="tel" class="form-control" @bind-Value="usuario.Telefono" maxlength="50" autocomplete="tel" /><ValidationMessage For="@(() => usuario.Telefono)" /></div>
                    <div class="col-12 mb-3"><label for="fechaIngreso">Fecha de ingreso</label><InputDate id="fechaIngreso" class="form-control" @bind-Value="usuario.FechaIngreso" /></div>
                    <div class="col-12"><VinculacionLaboralFields @bind-Tipo="usuario.TipoEvaluado" @bind-PuestoActual="usuario.PuestoActual" @bind-PuestoARotar="usuario.PuestoARotar" @bind-PuestoSolicitado="usuario.PuestoSolicitado" Disabled="@(guardando || guardado)" /></div>
                    <div class="col-md-6 mb-3">
                        <span class="fw-semibold">Estado de la cuenta</span>
                        <div class="form-check form-switch mt-2"><InputCheckbox id="cuentaActiva" class="form-check-input" role="switch" @bind-Value="usuario.Activo" disabled="@administradorPropio" /><label class="form-check-label" for="cuentaActiva">Cuenta activa</label></div>
                        <p class="small text-muted">@(usuario.Activo ? "Puede iniciar sesión." : "El acceso estará deshabilitado.")</p>
                    </div>
                    <div class="col-md-6 mb-3"><label for="rol">Rol</label><InputSelect id="rol" class="form-select" @bind-Value="usuario.Rol" disabled="@administradorPropio"><option value="">Seleccione un rol</option><option value="Usuario">Usuario</option><option value="Inspector">Inspector</option>@if (esAdministrador) { <option value="Administrador">Administrador</option> }</InputSelect><ValidationMessage For="@(() => usuario.Rol)" /></div>
                </div>
                @if (administradorPropio) { <p class="small text-muted">No puede desactivar su propia cuenta ni quitarse el rol de administrador.</p> }
                <div class="d-flex gap-2 flex-wrap"><button class="btn btn-primary" type="submit">@(guardando ? "Guardando..." : "Guardar cambios")</button><button class="btn btn-secondary" type="button" @onclick="Volver">Cancelar</button></div>
            </fieldset>
        </EditForm>
        @if (guardado) { <a class="btn btn-secondary mt-3" href="/verUsuarios">Volver a usuarios</a> }
    </div>
}
</div>
@code {
    [Parameter] public int IdUsuario { get; set; }
    [CascadingParameter] private Task<AuthenticationState> EstadoAutenticacion { get; set; } = default!;
    private EditUsuarioModel usuario = new();
    private bool isLoading=true, guardando, guardado, esAdministrador, administradorPropio;
    private string? errorCarga, mensaje;
    protected override Task OnParametersSetAsync() => Cargar();
    private async Task Cargar()
    {
        isLoading=true; errorCarga=null; mensaje=null; guardado=false;
        try
        {
            var state=await EstadoAutenticacion;
            esAdministrador=state.User.IsInRole("Administrador");
            using var response=await Http.GetAsync($"api/usuarios/{IdUsuario}");
            if (!response.IsSuccessStatusCode) { errorCarga=response.StatusCode==System.Net.HttpStatusCode.NotFound ? "Usuario no encontrado." : "No se pudo cargar el usuario. Compruebe la sesión y sus permisos."; return; }
            var data=await response.Content.ReadFromJsonAsync<EditUsuarioModel>();
            if(data==null) { errorCarga="No se recibieron datos del usuario."; return; }
            if(!esAdministrador && data.Rol=="Administrador") { errorCarga="Solo un administrador puede editar esta cuenta."; return; }
            usuario=data;
            administradorPropio=esAdministrador && state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value==IdUsuario.ToString();
        }
        catch(Exception ex) when(ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { errorCarga="No se pudo cargar el usuario. Compruebe la conexión."; }
        finally { isLoading=false; }
    }
    private async Task Guardar()
    {
        if(guardando || guardado) return;
        guardando=true;mensaje=null;
        try
        {
            var payload=new { usuario.NombreCompleto,usuario.Ci,usuario.Correo,usuario.Telefono,FechaIngreso=usuario.FechaIngreso?.ToString("yyyy-MM-dd"),usuario.TipoEvaluado,usuario.PuestoActual,usuario.PuestoSolicitado,usuario.PuestoARotar,usuario.Activo,usuario.Estado,usuario.Rol };
            using var response=await Http.PutAsJsonAsync($"api/usuarios/{IdUsuario}",payload);
            if(response.IsSuccessStatusCode) { guardado=true;mensaje="Usuario actualizado correctamente."; }
            else if(response.StatusCode==System.Net.HttpStatusCode.Unauthorized) mensaje="La sesión expiró. Inicie sesión nuevamente antes de guardar.";
            else if(response.StatusCode==System.Net.HttpStatusCode.Forbidden) mensaje="No tiene permisos para realizar estos cambios.";
            else { var text=await response.Content.ReadAsStringAsync();mensaje=string.IsNullOrWhiteSpace(text)?"No se pudo guardar. Revise los campos.":text; }
        }
        catch(Exception ex) when(ex is HttpRequestException or TaskCanceledException) { mensaje="No se pudo confirmar el guardado. Compruebe la conexión antes de reintentar."; }
        finally { guardando=false; }
    }
    private void Volver()=>Navigation.NavigateTo("/verUsuarios");
}
