@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject DELTATEST.Services.AuthService AuthService

<!-- ENCABEZADO GLOBAL -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm top-row w-100">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="images/logo.jpg" alt="Logo" class="logo-img me-2" />
        </a>

        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu"
                aria-controls="navbarNav" aria-expanded="@(isNavOpen ? "true" : "false")" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end @(isNavOpen ? "show" : "")" id="navbarNav">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill me-1"></span> Inicio
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/sobre-nosotros">
                        <span class="bi bi-people-fill me-1"></span> Sobre Nosotros
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/contacto">
                        <span class="bi bi-envelope-fill me-1"></span> Contacto
                    </NavLink>
                </li>
               
                <li class="nav-item">
                    @if (isOnAuthPage)
                    {
                        <!-- Si está en login o registro, mostrar "Volver" -->
                        <button class="btn btn-secondary ms-3" @onclick="GoBack">
                            <span class="bi bi-arrow-left me-1"></span> Volver
                        </button>
                    }
                    else
                    {
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-orange ms-3" @onclick="HandleSignOut">
                                    <span class="bi bi-box-arrow-right me-1"></span> Sign Out
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <NavLink class="btn btn-orange ms-3" href="/IniciarSesion">
                                    <span class="bi bi-box-arrow-in-right me-1"></span> Sign In
                                </NavLink>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- CONTENIDO DE CADA PÁGINA -->
<div class="main-content">
    @if (errorCierreSesion != null) { <div class="alert alert-danger" role="alert">@errorCierreSesion</div> }
    @Body
</div>

<!-- FOOTER CENTRADO -->
<footer class="footer mt-5 text-center">
    <div class="container">
        <div class="row justify-content-center mb-3">
            <div class="col-md-4">
                <h5 class="text-white mb-3">Empresa</h5>
                <ul class="list-unstyled">
                    <li><a href="/sobre-nosotros" class="footer-link"><i class="bi bi-building me-2"></i>Sobre Nosotros</a></li>
                    <li><a href="/contacto" class="footer-link"><i class="bi bi-envelope me-2"></i>Contacto</a></li>
                    <li><a href="/#convocatoria" class="footer-link"><i class="bi bi-file-earmark-text me-2"></i>Convocatoria</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5 class="text-white mb-3">Redes Sociales</h5>
                <ul class="list-unstyled">
                    <li><a href="https://www.facebook.com/share/1ETxTBPRFc/" target="_blank" class="footer-link"><i class="bi bi-facebook me-2"></i>Facebook</a></li>
                    <li><a href="https://www.instagram.com/deltalaboratorios.12?igsh=MWw4ZDJwbnRpcXN" target="_blank" class="footer-link"><i class="bi bi-instagram me-2"></i>Instagram</a></li>
                </ul>
            </div>
        </div>
        <p class="footer-copy">© 2025 Laboratorios Delta S.A. - Todos los derechos reservados.</p>
    </div>
</footer>

<style>
    .btn-orange {
        background-color: #f58220;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        transition: background-color 0.3s;
        cursor: pointer;
        font-weight: 500;
    }

        .btn-orange:hover {
            background-color: #d86c0a;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        transition: background-color 0.3s;
        cursor: pointer;
        font-weight: 500;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .navbar-nav .nav-link {
        color: #333 !important;
        font-weight: 500;
        transition: color 0.3s;
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

        .navbar-nav .nav-link:hover {
            color: #f58220 !important;
        }

    .navbar-brand img.logo-img {
        height: clamp(34px, 6vw, 45px);
        width: auto;
        display: block;
    }

    @@media (max-width: 991.98px) {
        .navbar-nav .nav-link { padding: .7rem 1rem !important; }
        .navbar-nav .btn-orange,
        .navbar-nav .btn-secondary { width: 100%; margin: .25rem 0 !important; }
    }

    .navbar {
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        min-height: 60px;
    }

    .main-content {
        padding: 0;
        margin: 0;
    }

    .main-body {
        padding-top: 85px;
    }

    .footer {
        background-color: #f58220;
        color: white;
        padding: 2rem 1rem;
    }

        .footer h5 {
            font-weight: 600;
        }

    .footer-link {
        color: white;
        text-decoration: none;
        font-size: 0.95rem;
        display: inline-block;
        margin-bottom: 0.5rem;
        transition: color 0.3s;
    }

        .footer-link:hover {
            color: #ffe6cc;
            text-decoration: underline;
        }

    .footer-copy {
        font-size: 0.85rem;
        margin-top: 1rem;
    }
</style>

@code {
    private string? errorCierreSesion;
    private bool isOnAuthPage;
    private bool isNavOpen;

    private void ToggleNavMenu() => isNavOpen = !isNavOpen;

    protected override void OnInitialized()
    {
        CheckCurrentPage();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isNavOpen = false;
        CheckCurrentPage();
        StateHasChanged();
    }

    private void CheckCurrentPage()
    {
        var uri = NavigationManager.Uri;
        isOnAuthPage = uri.Contains("/IniciarSesion", StringComparison.OrdinalIgnoreCase)
            || uri.Contains("/Registro", StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleSignOut()
    {
        errorCierreSesion = null;
        if (!await AuthService.LogoutAsync())
        {
            errorCierreSesion = "No se pudo cerrar la sesión. Compruebe la conexión e intente nuevamente.";
            return;
        }
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
