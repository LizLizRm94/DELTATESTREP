@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject DELTATEST.Services.AuthService AuthService

<!-- ENCABEZADO GLOBAL -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm top-row w-100 fixed-top">
    <div class="container-fluid px-4">

        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="images/logo.jpg" alt="Logo" class="logo-img me-2" />
        </a>

        <!-- Botón responsive -->
        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu"
                aria-controls="navbarNav" aria-expanded="@(isNavOpen ? "true" : "false")" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Enlaces -->
        <div class="collapse navbar-collapse justify-content-end @(isNavOpen ? "show" : "")" id="navbarNav">
            <ul class="navbar-nav align-items-center">

                <li class="nav-item">
                    <AuthorizeView Roles="Administrador,Inspector">
                        <Authorized>
                            <NavLink class="nav-link" href="/panelControlAdmin" Match="NavLinkMatch.All">
                                <span class="bi bi-house-door-fill me-1"></span> Inicio
                            </NavLink>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                                <span class="bi bi-house-door-fill me-1"></span> Inicio
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </li>

                <li class="nav-item">
                    <AuthorizeView>
                        <Authorized>
                            <button class="btn btn-orange ms-3" @onclick="HandleSignOut">
                                <span class="bi bi-box-arrow-right me-1"></span> Sign Out
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="btn btn-orange ms-3" href="/IniciarSesion">
                                <span class="bi bi-box-arrow-in-right me-1"></span> Sign In
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- CONTENIDO -->
<div class="main-body">
    @Body
</div>

<style>
    .btn-orange {
        background-color: #f58220;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        transition: background-color 0.3s;
    }

    .navbar-nav .btn-orange {
        background-color: #f58220;
        color: white;
    }

    .btn-orange:hover {
        background-color: #d86c0a;
    }

    .navbar-nav .nav-link {
        color: #333 !important;
        font-weight: 500;
        transition: color 0.3s;
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

        .navbar-nav .nav-link:hover {
            color: #f58220 !important;
        }
    /* logo */

    .navbar-brand img.logo-img {
        height: clamp(34px, 6vw, 45px);
        width: auto;
        display: block;
    }

    @@media (max-width: 991.98px) {
        .navbar-nav .nav-link { padding: .7rem 1rem !important; }
        .navbar-nav .btn-orange,
        .navbar-nav .btn-secondary { width: 100%; margin: .25rem 0 !important; }
    }

    .navbar {
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        min-height: 60px;
    }

    .main-content {
        padding: 0;
        margin: 0;
    }

    .main-body {
        padding-top: 85px;
    }
</style>

@code {
    private bool isNavOpen;

    private void ToggleNavMenu() => isNavOpen = !isNavOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isNavOpen = false;
        StateHasChanged();
    }

    private async Task HandleSignOut()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
